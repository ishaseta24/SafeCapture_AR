# Generate your own: openssl rand -hex 32
SAFE_CAPTURE_INGEST_TOKEN=replace-with-a-random-local-token
# Automatic per-photo masks: only tv,laptop are allowed. Unset or empty disables the policy.
SAFE_CAPTURE_AUTO_MASK_CLASSES=tv,laptop
PORT=8091
MAX_PHOTO_BYTES=5242880
MAX_PHOTO_PIXELS=12000000
UPLOAD_TIMEOUT_MS=20000
STALE_MS=15000
MAX_VIEWERS=8
# Optional absolute model path. Default: shared Assets/SafeCapture/Models/yolov8n.onnx
# SAFE_CAPTURE_MODEL_PATH=/absolute/path/to/yolov8n.onnx
