# Private local defaults. Do not commit .env or share its token.
# The Mac app reads its sandbox Application Support/SafeCaptureMentra/.env.
# In this checkout, Mentra/macos/.env links to that private runtime file.
# Configuration is loaded on launch or by clicking Reload .env.

SAFE_CAPTURE_WEBHOOK_URL=http://172.20.10.5:8091/mentra/photo
SAFE_CAPTURE_USB_WEBHOOK_URL=http://127.0.0.1:8091/mentra/photo
# Must match SAFE_CAPTURE_INGEST_TOKEN in Mentra/laptop/.env.
SAFE_CAPTURE_INGEST_TOKEN=replace-with-a-random-local-token
SAFE_CAPTURE_UPLOAD_MODE=wifi
SAFE_CAPTURE_ADB_SERIAL=
# Optional. Quote values containing # or leading/trailing spaces.
SAFE_CAPTURE_WIFI_SSID=
SAFE_CAPTURE_WIFI_PASSWORD=
