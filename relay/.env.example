# Meta AI API key — keep on laptop only, never commit
MODEL_API_KEY=your-meta-ai-api-key

# Shared secret between relay and Quest — generate with: openssl rand -hex 24
RELAY_TOKEN=your-relay-token-48-hex-chars

PORT=3000
MAX_PROMPTS=3
DAILY_CALL_CAP=1000
SAM_API_URL=https://api.meta.ai/v1/responses
MAX_IMAGE_WIDTH=960

# Set to true to save annotated debug frames to debug/
DEBUG_FRAMES=false
